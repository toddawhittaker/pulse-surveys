{
  // The TypeScript this repository actually holds, which is the Playwright
  // harness and the SPEC §9.2 specs it runs (E0-18 PR 2, E0-40 decision 2).
  // There is no frontend yet; when the E1 scaffold lands it brings its own
  // `frontend/tsconfig.json` and the `frontend` probe in
  // `.github/workflows/ci.yml` is what turns its build gates on.
  //
  // `noEmit` because nothing here is compiled: Playwright transpiles the specs
  // itself at run time, so `tsc` is only ever a checker in this repository.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "tests/e2e/**/*.ts"]
}
