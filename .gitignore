# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
# Anchored: CI's junit and licence reports land only at the root, and a bare
# reports/ would silently untrack a source directory of that name anywhere —
# frontend/src/copy/reports/ is exactly where E4's copy files would go.
/reports/
*.egg-info/

# Node
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Playwright (the e2e run's local output; the CI report is uploaded, not committed)
playwright-report/
test-results/
/playwright/.cache/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local overrides
.claude/settings.local.json
.claude/*.local.json

# Subagent memory (`memory: project` in .claude/agents/*.md). Local working
# state, not a repository artifact — and left untracked it gets swept into
# ticket commits by any agent running `git add -A`.
.claude/agent-memory/
