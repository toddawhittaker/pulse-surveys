# Pulse Surveys — configuration surface (SPEC §6.3).
#
# This file is the configuration documentation. Copy it to `.env` for local
# development; `.env` is gitignored and never committed. Every value below is a
# placeholder — no real credential belongs in this file, ever (CLAUDE.md).
#
# This file has four readers, not one: `app.config.Settings`, the Compose files,
# `backend/migrations/env.py`, which reads the three database variables it needs
# so that `alembic` works from a stock checkout (ADR 0012), and `scripts/seed.py`,
# which reads those three and ENVIRONMENT so that `make seed` does too (ADR 0063,
# ADR 0008 as amended). The process environment beats this file for all four. A
# unit test holds the file in sync with the first two, in both directions: a
# setting with no entry here fails, and an entry here that neither a setting nor a
# Compose file reads fails — the other two deliberately introduce no name of their
# own, so they need no entry and vouch for none.
#
# The second half is checked by finding the reader, never by naming it: an entry
# passes because a `Settings` field resolves to it or because a Compose file
# interpolates it as `${NAME}`. Stop interpolating a name and the entry starts
# failing on the next run, which is how an abandoned line gets noticed.

# ---------------------------------------------------------------------------
# Deployment wiring — required. No default exists for any of these, because a
# working default would be a misconfiguration that starts successfully.
# ---------------------------------------------------------------------------

# The database roles, and the parts the URL below is built from. They are
# separate entries for one reason: `docker-compose.yml` has to hand Postgres its
# own credentials, and Compose cannot parse a URL. Splitting the inputs keeps
# each password written once; the alternative was a second copy that can drift
# out of step. See docs/adr/0008.
#
# No `Settings` field reads any of these. The application reads DATABASE_URL and
# CARE_DATABASE_URL and nothing else — `app.config.Settings` ignores extra
# variables precisely so that `.env` can be one file for the application and for
# Compose both.
#
# **These seven must stay above the two URLs below**, for a narrower reason than
# "the file is read top-down". The `${...}` references that configure the `db`
# service live in docker-compose.yml, and Compose resolves those against the
# whole environment, so their position here is irrelevant. What is
# order-sensitive is the nested expansion inside those URLs' own values below.
#
# So moving this block down does not break the stack, it splits it: the database
# is still created with the right user and password, while the application is
# handed `postgresql+psycopg://:@db:5432/`. Nothing complains at
# `docker compose up`, and it surfaces as an authentication error two tickets
# later. Measured on the running daemon, and a test asserts it.
#
# Three roles, not one, and each has a job (docs/adr/0009, docs/adr/0001).
#
# DB_SUPERUSER is the role `initdb` creates. It is the cluster superuser, and
# that is sanctioned: migrations and system-level tasks need it, and nothing
# else does. It is deliberately not delivered to the application container —
# `docker-compose.yml` blanks it on the `api` service.
#
# DB_APP_USER is what the application connects as, every day, and it must never
# be a superuser: one bypasses every grant and every row-level security policy,
# and can run `COPY … FROM PROGRAM`, which is command execution inside the
# database container. `scripts/db-init` creates it on first start and grants it
# CONNECT (SPEC §4.1, docs/adr/0001 line 71, which ADR 0009 leaves standing).
#
# DB_CARE_USER exists so that reaching a student's name is a different
# *connection* rather than a different query. SPEC §6.2 gives the Care queue to
# the Care role and only the Care role; ADR 0001 makes that a database grant, so
# the application holds two credentials and only one of them can execute the
# audited reveal. It is not a superuser either, and it holds no SELECT on the
# identity table — its whole reach is one function that writes an audit row in
# the same transaction as the read. `scripts/db-init` creates it on first start
# and the E0-10 migration sets its attributes and its grants, exactly as for
# DB_APP_USER. Unlike DB_APP_USER, it is blanked on every application container:
# only `db` reads these two, and CARE_DATABASE_URL below says why.
#
# **Neither URL below may point at DB_SUPERUSER, and they must not point at each
# other's role either.** DATABASE_URL is DB_APP_USER; CARE_DATABASE_URL is
# DB_CARE_USER. Pointing both at one role is the separation undone in one line.
DB_SUPERUSER=pulse_admin
DB_SUPERUSER_PASSWORD=replace-me-admin
DB_APP_USER=pulse_app
DB_APP_PASSWORD=replace-me-app
DB_CARE_USER=pulse_care
DB_CARE_PASSWORD=replace-me-care
DB_NAME=pulse

# Application database. `postgresql+psycopg://user:password@host:port/database`.
#
# The host is the Compose service name, because the file this is copied to has
# to be one the stack can actually start from — CI does `cp .env.example .env`
# and then `docker compose up`. Running uvicorn on the host instead of in a
# container therefore needs this and REDIS_URL pointed back at localhost; the
# README says so where it tells you to do that.
#
# Both Compose and python-dotenv expand `${...}` here, so the parts above reach
# the container and the host process alike.
#
# The `+psycopg` driver is named here and in the migration-drift job, and is
# pinned in pyproject.toml as `psycopg[binary]` — the binary extra because the
# runtime image carries no libpq for the pure-Python distribution to find.
#
# Alembic reads this entry too, for the host, port and database it names, and
# then connects as DB_SUPERUSER rather than as the role in the URL (ADR 0009,
# ADR 0012). Running a migration from your own machine therefore needs a host
# this machine can resolve; README.md says where to point it.
DATABASE_URL=postgresql+psycopg://${DB_APP_USER}:${DB_APP_PASSWORD}@db:5432/${DB_NAME}

# The Care queue's connection to the same database, as a different role (§6.2,
# ADR 0001, ADR 0042). Same host, same database, same driver — the only thing
# that differs is who is connecting, and that is the whole point: `pulse_app`
# holds no privilege on the identity table and cannot execute the reveal, so an
# instructor screen physically cannot produce a name however it is written.
#
# Read by `app.services.safety` and by nothing else, and **only the API process
# is given it**. `docker-compose.yml` blanks this entry on `worker` and `beat`,
# which never serve this queue — `worker` is the process that ships comment text
# to a third-party model provider, so it is the last container that should hold a
# route to a student's name. The DB_CARE_USER and DB_CARE_PASSWORD parts above it
# are blanked on **every** application container including `api`, as the note at
# DB_CARE_USER says: only `db` needs the parts, and leaving them anywhere else
# would rebuild this URL out of them in three pieces while this line read as
# withheld. `app.config.Settings` therefore treats this as
# optional and reads a blank value as absent — a reveal attempted in a process
# without it fails naming this variable (ADR 0042, as amended).
#
# So this line is not optional for a deployment. It is optional per *process*,
# and the two that do without it are the two Compose withholds it from.
CARE_DATABASE_URL=postgresql+psycopg://${DB_CARE_USER}:${DB_CARE_PASSWORD}@db:5432/${DB_NAME}

# Celery broker and result backend. The Compose service name, for the same
# reason as above.
REDIS_URL=redis://redis:6379/0

# Any OpenAI-compatible endpoint (§7.4): a hosted provider, a proxy, or a local
# server such as vLLM or Ollama.
AI_PROVIDER_BASE_URL=https://api.example-provider.test/v1
AI_MODEL_NAME=replace-with-your-model-id

# The provider's credential, read by `app.ai.gateway` and by nothing else. It is
# a secret: the value below is a placeholder, and a real key belongs in `.env` or
# in the deployment's secret store and nowhere else (SPEC §10, CLAUDE.md).
# `app.config.Settings` holds it as a `SecretStr`, so it is masked in every
# rendering that object has, and the gateway raises no error with the provider's
# own exception chained behind it — a chained cause's message reaches the
# container log too.
#
# **Leave it empty when the endpoint authenticates nobody** — vLLM, Ollama, a
# proxy on the same host. A blank value is read as absent, and the request then
# carries an inert placeholder bearer token rather than an empty one, which is
# what those servers ignore and some of them refuse. README.md says the same
# where it tells you how to run without a key.
#
# **Setting this makes the base URL above a TLS matter.** With a credential
# configured, AI_PROVIDER_BASE_URL must be https unless it names this machine;
# plain http to anywhere else would put the credential and the comment being
# classified on the wire in the clear, and startup refuses it (§10).
AI_PROVIDER_API_KEY=replace-me-with-your-provider-key

# IANA timezone the survey window follows (§3.1). Rejected at startup if the
# runtime cannot resolve it.
INSTITUTION_TIMEZONE=America/New_York

# Free-form deployment name, reported by /healthz. The spec does not constrain
# the vocabulary; `development`, `staging`, and `production` are conventions.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Defaulted — optional, and these values apply when unset. Why each one has a
# default differs, so the reason is on the entry rather than in this heading.
# ---------------------------------------------------------------------------

# The two entry doors' addresses (E0-18). Every one of these is an address, and
# each default is this repository's own development stack — the values
# `docker-compose.yml` and `docker-compose.override.yml` actually run with, so
# `docker compose up` from a clean checkout reaches a launchable system with no
# `.env` edits at all (SPEC §14.3). None of them can resolve in a deployment, so
# a deployment that forgets one gets a launch that fails at its first hop rather
# than a system that is quietly wrong. See docs/adr/0075.
#
# **Two horizons, decided per value rather than per service.** A browser on the
# host reaches these services on published ports at `localhost`; the `api`
# container reaches them by Compose service name. A value a browser is
# *redirected to* is `localhost`; a value the tool *fetches* is the service name.
# Getting this backwards produces a stack that passes every in-process test and
# sends a real browser to a name it cannot resolve.

# Browser-facing base URL of this tool. `/lti/launch` and `/auth/oidc/callback`
# are derived from it, and both mocks compare the result exactly against the
# address they were registered with — so this and the two `MOCK_*` overrides in
# docker-compose.override.yml move together.
PUBLIC_BASE_URL=http://localhost:8000

# The LTI platform's browser-facing authorization endpoint — where a launch is
# sent after `/lti/login`. A setting rather than an `lti_platform` column
# because E0-23 put service addresses in E1, with the code that reads them.
LTI_PLATFORM_AUTHORIZATION_ENDPOINT=http://localhost:8080/oidc/authorize

# The identity provider (§2's web login door), split the same way. The issuer is
# neither browser-facing nor fetched: it is the `iss` an `id_token` must state,
# compared as a string (OIDC Core 1.0 §3.1.3.7), so it stays the name the
# provider calls itself by.
OIDC_ISSUER=http://mock-idp:8000
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8081/oidc/authorize
OIDC_TOKEN_ENDPOINT=http://mock-idp:8000/oidc/token
OIDC_JWKS_URL=http://mock-idp:8000/.well-known/jwks.json

# This tool's registered client at the provider. The client is public: it holds
# no secret, and PKCE is what binds an authorization code to it (RFC 7636). So
# there is no OIDC_CLIENT_SECRET here, and its absence is the design rather than
# an omission.
OIDC_CLIENT_ID=mock-idp-client

# Root log level: CRITICAL, ERROR, WARNING, INFO, or DEBUG. This project's
# choice, not the spec's — §6.3 enumerates the configuration surface and a log
# level is not in it.
#
# Read twice, and deliberately so: by `app.config.Settings` for the application,
# and by `docker-compose.yml`, which passes it to `celery worker` and
# `celery beat` as `--loglevel`. Turning the stack up to DEBUG is one edit.
LOG_LEVEL=INFO

# Responses in a reporting week below which raw comments stay hidden from
# instructors and students alike (§4, §4.1 invariant 3). Configurable, default 5.
N_THRESHOLD_DEFAULT=5

# Benchmark minimum-N (§5.1), distinct from the section small-N above. SPEC §11
# open question 1 leaves the numbers unsettled and suggests these as starting
# values; expect them to move once there is real data behind them.
BENCHMARK_MIN_SECTIONS_DEFAULT=3
BENCHMARK_MIN_RESPONDENTS_DEFAULT=15
