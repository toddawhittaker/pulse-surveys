+"""Names and Role Provisioning Service 2.0 roster sync."""
+
+from __future__ import annotations
+
+import httpx
+
+from app.config import Settings
+from app.models.identity import Enrollment
+
+MEMBERSHIP_ACCEPT = "application/vnd.ims.lti-nrps.v2.membershipcontainer+json"
+
+
+async def fetch_roster(
+    client: httpx.AsyncClient,
+    context_memberships_url: str,
+    token: str,
+) -> list[dict]:
+    """Return every member of the context."""
+    response = await client.get(
+        context_memberships_url,
+        headers={
+            "Authorization": f"Bearer {token}",
+            "Accept": MEMBERSHIP_ACCEPT,
+        },
+        timeout=30.0,
+    )
+    response.raise_for_status()
+    body = response.json()
+    return body.get("members", [])
+
+
+def to_enrollments(members: list[dict], section_id: int) -> list[Enrollment]:
+    """Map NRPS members onto enrollment rows."""
+    enrollments = []
+    for member in members:
+        roles = " ".join(member.get("roles", []))
+        if "Instructor" in roles:
+            role = "instructor"
+        else:
+            role = "student"
+
+        enrollments.append(
+            Enrollment(
+                section_id=section_id,
+                lms_user_id=member["user_id"],
+                role=role,
+                active=member.get("status", "Active") == "Active",
+            )
+        )
+    return enrollments
